# Frontend environment example for ZeroCharts
# Copy to .env or .env.local (ignored) and adjust values.

VITE_APP_NAME=ZeroCharts
# Base URL da API (terminar sem /api se quiser mudar helper) - já usamos /api internamente
VITE_API_BASE_URL=http://localhost:8081/api

# Google OAuth (ID público - pode ser exposto)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
