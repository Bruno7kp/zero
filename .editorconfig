# EditorConfig helps maintain consistent coding styles between editors
root = true

[*.{js,ts,jsx,tsx,json,css,scss,md,html}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 100

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.php]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
