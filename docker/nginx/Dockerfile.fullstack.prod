## Nginx fullstack: serve SPA build + encaminha /api para php-fpm (backend)

FROM node:22-alpine AS frontend
ARG GIT_SHA=dev
ARG VITE_API_BASE_URL=/api
WORKDIR /app/frontend
COPY ../../frontend/package*.json ./
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm ci --no-audit --no-fund
COPY ../../frontend .
RUN npm run build

# Não precisamos compilar nada do backend aqui além da pasta public
FROM alpine:3.20 AS backend_public
WORKDIR /src
COPY ../../backend/public ./public

## Runtime Nginx
FROM nginx:stable-alpine AS runtime
ARG GIT_SHA=dev
WORKDIR /var/www/html

# Copia public Laravel (index.php, assets base)
COPY --from=backend_public /src/public ./public
# Copia build do frontend para public/spa
COPY --from=frontend /app/frontend/dist ./public/spa

# Config Nginx fullstack
COPY ../../docker/nginx/nginx.fullstack.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
LABEL org.opencontainers.image.source="https://github.com/Bruno7kp/zero" \
	org.opencontainers.image.revision="$GIT_SHA" \
	org.opencontainers.image.title="zero-web" \
	org.opencontainers.image.description="ZeroCharts web (nginx + SPA)"

CMD ["nginx", "-g", "daemon off;"]
